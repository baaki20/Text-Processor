<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dataflow.controller.MainController">    <top>
        <VBox styleClass="header-container">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Text styleClass="title-text" text="DataFlow" />
                        <Text styleClass="subtitle-text" text="Regex &amp; Text Processing Tool" />
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                </HBox>
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleOpenFile" text="Open..." />
                                <MenuItem mnemonicParsing="false" onAction="#handleSaveFile" text="Save As..." />
                                <SeparatorMenuItem mnemonicParsing="false" />
                                <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Edit">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleClear" text="Clear All" />
                                <MenuItem mnemonicParsing="false" onAction="#handleCopyResults" text="Copy Results" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleAbout" text="About" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </children>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="Regex Operations">
                    <content>
                        <BorderPane>
                            <top>
                                <GridPane hgap="15.0" vgap="10.0" BorderPane.alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="form-label" text="Regex Pattern:" />
                                                <TextField fx:id="regexPatternField" promptText="Enter regex pattern" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#handleValidatePattern" styleClass="action-button" text="Validate" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1">
                                            <children>
                                                <Label styleClass="form-label" text="Operation:" />
                                                <ComboBox fx:id="operationComboBox" prefWidth="200.0" promptText="Select operation" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.rowIndex="1">
                                            <children>
                                                <Label styleClass="form-label" text="Replacement:" />
                                                <TextField fx:id="replacementField" promptText="Replacement text (for replace operations)" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#handleExecuteOperation" styleClass="primary-button" text="Execute" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </GridPane>
                            </top>
                            <center>
                                <SplitPane dividerPositions="0.5" orientation="VERTICAL" prefHeight="200.0" prefWidth="160.0" BorderPane.alignment="CENTER">
                                    <items>
                                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
                                            <children>
                                                <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                                    <children>
                                                        <Label styleClass="section-header" text="Input Text">
                                                            <padding>
                                                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                                            </padding>
                                                        </Label>
                                                        <TextArea fx:id="inputTextArea" promptText="Enter text or load from file..." wrapText="true" VBox.vgrow="ALWAYS" />
                                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                            <padding>
                                                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                                            </padding>
                                                            <children>
                                                                <Button mnemonicParsing="false" onAction="#handleLoadSample" styleClass="action-button" text="Load Sample" />
                                                                <Button mnemonicParsing="false" onAction="#handleClearInput" styleClass="action-button" text="Clear" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </AnchorPane>
                                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="160.0">
                                            <children>
                                                <VBox layoutX="120.0" layoutY="35.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                                    <children>
                                                        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                                            <tabs>
                                                                <Tab text="Results">
                                                                    <content>
                                                                        <VBox>
                                                                            <children>
                                                                                <TextArea fx:id="outputTextArea" editable="false" promptText="Results will appear here" wrapText="true" VBox.vgrow="ALWAYS" />
                                                                            </children>
                                                                        </VBox>
                                                                    </content>
                                                                </Tab>
                                                                <Tab text="Match Details">
                                                                    <content>
                                                                        <TableView fx:id="matchesTableView">
                                                                            <columns>
                                                                                <TableColumn fx:id="matchTextColumn" prefWidth="300.0" text="Match" />
                                                                                <TableColumn fx:id="startIndexColumn" prefWidth="100.0" text="Start Index" />
                                                                                <TableColumn fx:id="endIndexColumn" prefWidth="100.0" text="End Index" />
                                                                            </columns>
                                                                        </TableView>
                                                                    </content>
                                                                </Tab>
                                                            </tabs>
                                                        </TabPane>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </AnchorPane>
                                    </items>
                                </SplitPane>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>
                <Tab text="Text Analytics">
                    <content>
                        <BorderPane>
                            <center>
                                <SplitPane dividerPositions="0.3" BorderPane.alignment="CENTER">
                                    <items>
                                        <VBox spacing="10.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="section-header" text="Analytics Options" />
                                                <TitledPane animated="false" expanded="true" text="Text Summary">
                                                    <content>
                                                        <VBox spacing="5.0">
                                                            <children>
                                                                <Button mnemonicParsing="false" onAction="#handleTextSummary" styleClass="full-width-button" text="Generate Summary" />
                                                            </children>
                                                        </VBox>
                                                    </content>
                                                </TitledPane>
                                                <TitledPane animated="false" text="Word Frequency">
                                                    <content>
                                                        <VBox spacing="5.0">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <Label text="Min Count:" />
                                                                        <Spinner fx:id="minCountSpinner" amountToStepBy="1" editable="true" initialValue="1" max="100" min="1" prefWidth="100.0" />
                                                                    </children>
                                                                </HBox>
                                                                <Button mnemonicParsing="false" onAction="#handleWordFrequency" styleClass="full-width-button" text="Calculate Frequency" />
                                                            </children>
                                                        </VBox>
                                                    </content>
                                                </TitledPane>
                                                <TitledPane animated="false" text="Pattern Matching">
                                                    <content>
                                                        <VBox spacing="5.0">
                                                            <children>
                                                                <TextField fx:id="filterPatternField" promptText="Enter filter pattern" />
                                                                <Button mnemonicParsing="false" onAction="#handleFilterLines" styleClass="full-width-button" text="Filter Lines by Pattern" />
                                                            </children>
                                                        </VBox>
                                                    </content>
                                                </TitledPane>
                                            </children>
                                        </VBox>
                                        <TabPane>
                                            <tabs>
                                                <Tab text="Results">
                                                    <content>
                                                        <TextArea fx:id="analyticsResultsArea" editable="false" promptText="Analytics results will appear here" wrapText="true" />
                                                    </content>
                                                </Tab>
                                                <Tab text="Data View">
                                                    <content>
                                                        <TableView fx:id="analyticsTableView">
                                                            <columns>
                                                                <TableColumn fx:id="keyColumn" prefWidth="200.0" text="Key" />
                                                                <TableColumn fx:id="valueColumn" prefWidth="200.0" text="Value" />
                                                            </columns>
                                                        </TableView>
                                                    </content>
                                                </Tab>
                                            </tabs>
                                        </TabPane>
                                    </items>
                                </SplitPane>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>
                <Tab text="Data Management">
                    <content>
                        <BorderPane>
                            <top>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
                                    <children>
                                        <Label styleClass="section-header" text="Text Records Management" />
                                    </children>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </HBox>
                            </top>
                            <center>
                                <SplitPane dividerPositions="0.6" BorderPane.alignment="CENTER">
                                    <items>
                                        <VBox>
                                            <children>
                                                <TableView fx:id="recordsTableView" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="recordIdColumn" prefWidth="100.0" text="ID" />
                                                        <TableColumn fx:id="recordLabelColumn" prefWidth="200.0" text="Label" />
                                                        <TableColumn fx:id="recordContentColumn" prefWidth="300.0" text="Content" />
                                                    </columns>
                                                </TableView>
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                    <padding>
                                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                    </padding>
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#handleDeleteRecord" styleClass="warning-button" text="Delete Selected" />
                                                        <Button mnemonicParsing="false" onAction="#handleClearRecords" styleClass="warning-button" text="Clear All" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="10.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                            <children>
                                                <Label styleClass="section-header" text="Record Details" />
                                                <GridPane hgap="10.0" vgap="10.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="100.0" />
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                    </rowConstraints>
                                                    <children>
                                                        <Label styleClass="form-label" text="ID:" />
                                                        <Label styleClass="form-label" text="Label:" GridPane.rowIndex="1" />
                                                        <Label styleClass="form-label" text="Content:" GridPane.rowIndex="2" />
                                                        <TextField fx:id="recordIdField" GridPane.columnIndex="1" />
                                                        <TextField fx:id="recordLabelField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                        <TextArea fx:id="recordContentArea" prefHeight="200.0" prefWidth="200.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                    </children>
                                                </GridPane>
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#handleAddRecord" styleClass="primary-button" text="Add New" />
                                                        <Button mnemonicParsing="false" onAction="#handleUpdateRecord" styleClass="primary-button" text="Update" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </items>
                                </SplitPane>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
    <bottom>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" progress="0.0" />
                <HBox alignment="CENTER_LEFT" styleClass="status-bar">
                    <children>
                        <Label fx:id="statusLabel" text="Ready" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
